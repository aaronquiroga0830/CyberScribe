{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "web",
    "rootDir": "web",
    "skipLibCheck": true,
    "moduleResolution": "bundler"
  },
  "include": ["web/**/*.ts"],
  "exclude": ["web/dist"]
}
