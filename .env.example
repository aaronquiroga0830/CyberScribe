# CyberScribe: copy to .env in the project root (keep an existing .env).
# Install Ollama separately: https://ollama.com then: ollama pull gemma2:2b

# LLM (Ollama on same host)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
# Optional timeout per generation request (seconds); unset means no limit.
# OLLAMA_GENERATE_TIMEOUT_S=300
# OLLAMA_BASE_URL_RMP=
# OLLAMA_BASE_URL_TIMELINE=

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store: faiss or chroma
VECTOR_STORE_TYPE=faiss

# Paths: relative to project root, or set absolute paths on Linux, e.g. /var/cyberscribe/data
DATA_DIR=data
OUTPUT_DIR=output
