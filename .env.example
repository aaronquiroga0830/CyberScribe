# Copy to .env in the project root. Defaults work on Linux with relative paths (DATA_DIR=data).
# Ollama must be installed separately: https://ollama.com  then: ollama pull phi3

# LLM (Ollama on same host)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3
# OLLAMA_BASE_URL_RMP=
# OLLAMA_BASE_URL_TIMELINE=

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store: faiss or chroma
VECTOR_STORE_TYPE=faiss

# Paths: relative to project root, or set absolute paths on Linux, e.g. /var/mission-rag/data
DATA_DIR=data
OUTPUT_DIR=output
